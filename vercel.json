{
  "version": 2,
  "buildCommand": "cd apps/api && npm run build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "apps/api/dist/index.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/pg/**",
          "node_modules/pg-types/**",
          "node_modules/pgpass/**",
          "node_modules/pdf-parse/**",
          "node_modules/pdfjs-dist/**",
          "node_modules/@napi-rs/**"
        ]
      }
    }
  ],
  "functions": {
    "apps/api/dist/index.cjs": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/dist/index.cjs"
    }
  ]
}
