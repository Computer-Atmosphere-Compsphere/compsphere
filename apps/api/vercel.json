{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "dist/index.cjs",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 15,
        "includeFiles": [
          "node_modules/pg/**",
          "node_modules/pg-types/**",
          "node_modules/pgpass/**",
          "node_modules/pdf-parse/**",
          "node_modules/pdfjs-dist/**",
          "node_modules/@napi-rs/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.cjs"
    }
  ]
}
