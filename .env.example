# =============================================================================
# COMPSPHERE.ID — Environment Variables Template
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local Docker PostgreSQL (default for development)
DATABASE_URL=postgresql://compsphere:compsphere_dev@localhost:5432/compsphere

# For production, replace with your managed PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# BETTER-AUTH (Authentication)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-strong-random-secret

# The URL of your API server (backend)
BETTER_AUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# See README.md for step-by-step setup instructions.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# ACCESS TOKENS (NEVER expose these to frontend)
# Generate with: openssl rand -hex 32
# These are set server-side only (environment variables, never in DB plaintext)
# -----------------------------------------------------------------------------
COMMITTEE_ACCESS_TOKEN=replace-with-strong-random-committee-token
JUDGE_ACCESS_TOKEN=replace-with-strong-random-judge-token

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
# Local development: files stored in apps/api/uploads/ (no extra config needed)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# For production with Hostinger PHP storage bridge:
# STORAGE_PROVIDER=hostinger
# HOSTINGER_STORAGE_URL=https://files.yourdomain.com/storage/storage.php
# HOSTINGER_UPLOAD_TOKEN=   # openssl rand -hex 32 — authenticates write requests
# HOSTINGER_SIGNING_KEY=    # openssl rand -hex 32 — signs presigned read URLs (must differ from UPLOAD_TOKEN)

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Production: comma-separated if multiple domains (e.g. with and without www)
# FRONTEND_URL=https://compsphere12.id,https://www.compsphere12.id
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# FRONTEND (VITE — prefix with VITE_ to expose to browser)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# OPTIONAL: EMAIL (Resend) — not required for MVP
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=noreply@compsphere.id
