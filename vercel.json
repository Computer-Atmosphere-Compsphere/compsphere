{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build -w packages/types && npm run build -w apps/api && npm run build -w apps/web",
  "builds": [
    {
      "src": "apps/api/dist/index.cjs",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 15,
        "includeFiles": [
          "node_modules/pg/**",
          "node_modules/pg-types/**",
          "node_modules/pgpass/**",
          "node_modules/pdf-parse/**",
          "node_modules/pdfjs-dist/**",
          "node_modules/@napi-rs/**"
        ]
      }
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(api\\.compsphere12\\.id|.*-api.*)"
        }
      ],
      "dest": "apps/api/dist/index.cjs"
    },
    {
      "src": "/api/(.*)",
      "dest": "apps/api/dist/index.cjs"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "apps/api/dist/index.cjs"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "dest": "/index.html"
    }
  ]
}
